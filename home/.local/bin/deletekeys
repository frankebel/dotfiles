#!/bin/sh
# Delete subkeys which are not for the current device.

# all subkeys
keys='
28B8E38CEC834526F05470522FD9DA69091AAB8D.key
7C551C488C40E71141061D7AC9C4C2F2FC54D08E.key
E83F60B78755DBFE469AAA1DC7C1CA450B842274.key
F3BEE7381F7B95146098B22FBF27F264A152A2AA.key
FE4A577C1915B918A1ABC5239F3A7537D173DEBF.key
'

case $(uname -n) in
    *desktop*) keep=E83F60B78755DBFE469AAA1DC7C1CA450B842274.key ;;
    *laptop*) keep=28B8E38CEC834526F05470522FD9DA69091AAB8D.key ;;
    *tuw*) keep=F3BEE7381F7B95146098B22FBF27F264A152A2AA.key ;;
esac

cd "$GNUPGHOME/private-keys-v1.d" || exit
for key in $keys; do
    [ "$key" = "$keep" ] && continue
    [ -f "$key" ] && shred -u "$key"
done
gpg --list-secret-keys
