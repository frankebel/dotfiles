#!/bin/sh
# Unmount devices with udiskie-umount.

find "/run/media/$USER" -mindepth 1 -maxdepth 1 \
    | fzf \
        --delimiter=/ \
        --exit-0 \
        --multi \
        --prompt="Select drives to eject:" \
        --select-1 \
        --with-nth=-1 \
    | xargs -r -d '\n' udiskie-umount
