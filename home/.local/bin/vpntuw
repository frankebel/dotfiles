#!/bin/sh
# Toggle the TUW VPN.

if pgrep -x openconnect > /dev/null; then
    sudo killall --quiet -SIGINT openconnect
    printf '%s\n' 'VPN disconnected'
    exit 0
fi

printf "%s\n%s" "$(pass show tuw/tiss | head -n1)" "$(pass otp tuw/tiss)" | sudo openconnect \
    --useragent="AnyConnect OpenConnect" \
    --no-external-auth \
    --authgroup="1_TU_getunnelt" \
    --background \
    --passwd-on-stdin \
    --user "$(pass show tuw/mail | awk '$1 == "user3:" {print $2}')" \
    vpn.tuwien.ac.at
