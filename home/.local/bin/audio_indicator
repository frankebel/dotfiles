#!/bin/sh
# Show notification with audio volume indicator (sink or source).
# `id` is random, but unique for notifications

case "${1:-}" in
    sink)
        port="@DEFAULT_AUDIO_SINK@"
        id=4528
        icon_muted="󰖁"
        icon="󰕾"
        ;;
    source)
        port="@DEFAULT_AUDIO_SOURCE@"
        id=7016
        icon_muted="󰍭"
        icon="󰍬"
        ;;
    *)
        printf 'usage: %s sink|source\n' "$0" >&2
        exit 1
        ;;
esac

app_name="changevolume"
timeout=2000

case "$(wpctl get-volume "$port")" in
    *MUTED*)
        notify-send -a "$app_name" -t "$timeout" -r "$id" "$icon_muted"
        ;;
    *)
        volume="$(wpctl get-volume "$port" | grep -Po '\d\.\d+')"
        volume="$(echo "$volume" | awk '{printf "%.0f", $1 * 100}')" # Convert to percentage
        notify-send -a "$app_name" -t "$timeout" -r "$id" -h int:value:"$volume" "$icon $volume %"
        ;;
esac
