#!/usr/bin/env bash
# Render LaTeX math inline using the kitty graphics protocol.
#
# Usage:
#   pi_latex_inline '\mathrm{i}\hbar\,\partial_t \,|\psi\rangle = \hat{H}|\psi\rangle'
#
# Finds the pi process's terminal automatically and writes kitty graphics
# protocol sequences directly to it, bypassing captured stdout.

set -euo pipefail

DENSITY=300
OUT="/tmp/pi_latex_inline_output.pdf"

INPUT="${1:?no LaTeX input provided}"

# Resolve pi's terminal device by walking up the process tree.
find_pi_tty() {
    local pid=$$ # current process
    for _ in $(seq 1 10); do
        local tty comm
        tty=$(ps -o tty= -p "$pid" 2> /dev/null | tr -d ' ')
        comm=$(ps -o comm= -p "$pid" 2> /dev/null | tr -d ' ') # command name
        if [ "$comm" = "pi" ] && [ -n "$tty" ] && [ "$tty" != "?" ]; then
            # found tty to render image
            echo "/dev/$tty"
            return 0
        fi

        local ppid # parent pid
        ppid=$(ps -o ppid= -p "$pid" 2> /dev/null | tr -d ' ')

        # reach root without finding pi
        [ -z "$ppid" ] || [ "$ppid" = "0" ] || [ "$ppid" = "1" ] && return 1
        pid="$ppid"
    done
    return 1
}

PI_TTY="$(find_pi_tty || true)"
[ -n "$PI_TTY" ] && [ -w "$PI_TTY" ] || {
    echo "could not find writable pi terminal (tried walking process tree)" >&2
    exit 1
}

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT
TEX="$TMPDIR/eq"

# Wrap bare math in \[ ... \]; pass environments through unwrapped.
case "$INPUT" in
    *'\begin{'*)
        BODY="$INPUT"
        ;;
    *)
        BODY="\[$INPUT\]"
        ;;
esac

cat > "$TEX.tex" << EOF
\documentclass[preview,border=2pt]{standalone}
\usepackage{amsmath}
\begin{document}
$BODY
\end{document}
EOF

if ! lualatex -interaction=nonstopmode -output-directory="$TMPDIR" "$TEX.tex" > /dev/null 2>&1; then
    echo "lualatex failed. Bad LaTeX?" >&2
    echo "Input: $INPUT" >&2
    # dump stderr if failed
    lualatex -interaction=nonstopmode -output-directory="$TMPDIR" "$TEX.tex" >&2 || true
    exit 1
fi

cp "$TEX.pdf" "$OUT"
echo "Saved: $OUT"

# white background, no transparency
convert -density "$DENSITY" "$TEX.pdf" -background white -flatten -quality 90 "$TEX.png" 2> /dev/null
[ -f "$TEX.png" ] || {
    echo "convert failed" >&2
    exit 1
}

# Send via kitty graphics protocol to pi's terminal.
height=$(identify -format '%h' "$TEX.png") || {
    echo "identify failed" >&2
    exit 1
}
num_lines=$(((height + 19) / 20)) # 20 px per line
[ "$num_lines" -lt 1 ] && num_lines=1

data=$(base64 -w0 "$TEX.png")
total=$(printf '%s\n' "$data" | fold -w 4096 | wc -l)

{
    printf '\n'
    i=0
    while IFS= read -r part; do
        if [ "$i" -eq 0 ]; then
            params="a=T,f=100,t=d,s=1,v=1"
            [ "$total" -gt 1 ] && params="$params,m=1"
        elif [ "$i" -eq $((total - 1)) ]; then
            params="m=0"
        else
            params="m=1"
        fi
        printf '\x1b_G%s;%s\x1b\x5c' "$params" "$part"
        i=$((i + 1))
    done < <(printf '%s\n' "$data" | fold -w 4096)
    printf '\n%.0s' $(seq "$num_lines")
} > "$PI_TTY"
