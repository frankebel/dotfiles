# See zathurarc(5)

# Catppuccin Mocha
include catppuccin-mocha

# keep white background
# need different highlight colors as mocha is optimized for dark pages
set recolor false
set highlight-color rgba(245,224,220,0.8)
set highlight-fg rgba(17,17,27,1)
set highlight-active-color rgba(203,166,247,0.8)

# Startup options
set adjust-open width

set selection-clipboard clipboard

# link hint numbers
set font "monospace normal 12"
