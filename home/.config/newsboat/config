# See newsboat(1)

# Options
datetime-format %FT%T
max-items 8
reload-threads 100
scrolloff 8

# Keybinds
bind-key j down
bind-key k up
bind-key l open
bind-key h quit
bind-key g home
bind-key G end

# Colors
include ~/.config/newsboat/dark

# Highlighting text
highlight feedlist ---.*--- blue default bold
# highlight feedlist ".*0/0.." default default invis

# Macros
# open-in-browser default key  "o"
macro v set browser "mpv --sid=no -- %u"; open-in-browser; set browser firefox; toggle-article-read -- "Open in mpv"
